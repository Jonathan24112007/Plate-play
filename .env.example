# ─── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/plateplay?schema=public"

# ─── NextAuth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (Sign in / Sign up with Google) ──────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Authorized JavaScript origin: http://localhost:3000
# Authorized redirect URI:      http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Admin Credentials ─────────────────────────────────────────────────────
# The admin dashboard uses a single admin account
ADMIN_EMAIL="admin@plateplay.com"
# Generate hash: node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH="$2b$12$replace-with-bcrypt-hash"

# ─── Email (Resend) ────────────────────────────────────────────────────────
# Get from https://resend.com — if not set, emails are skipped (logged only)
RESEND_API_KEY=""
# The "from" address (must be verified in Resend)
EMAIL_FROM="PlatePlay <hello@plateplay.com>"

# ─── Operating Mode ────────────────────────────────────────────────────────
# DEMO     = No real slots, all actions are illustrative
# PILOT    = Pilot slots available; booking requests accepted
# LIVE     = Full live operations
PLATEPLAY_MODE="DEMO"

# ─── Waitlist ──────────────────────────────────────────────────────────────
WAITLIST_STORAGE_ENABLED="false"
